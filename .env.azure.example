# Siel Cart -- Azure App Service (Linux F1) preview settings.
#
# Reference only. On Azure these are entered as App Settings (Configuration
# -> Environment variables), never uploaded as a .env file: the deploy
# workflow excludes every .env file from the package. Placeholders only --
# do not commit real values. See docs/azure-deployment.md.

APP_NAME="SIEL CART"
APP_ENV=production
APP_DEBUG=false
# Generate once (`php artisan key:generate --show`) and keep it stable:
# changing it logs everyone out and breaks anything encrypted with the old key.
APP_KEY=base64:REPLACE_WITH_A_STABLE_KEY
APP_URL=https://your-app-name.azurewebsites.net

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stderr
LOG_LEVEL=warning

# Aiven MySQL: copy host, port, database, user and password exactly from the
# service's "Connection information". The port is Aiven's custom port.
DB_CONNECTION=mysql
DB_HOST=your-service-your-project.x.aivencloud.com
DB_PORT=REPLACE_WITH_AIVEN_PORT
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=REPLACE_WITH_AIVEN_PASSWORD

# Verified TLS is mandatory: startup fails if the CA is missing or unreadable.
DB_SSL_REQUIRE_VERIFIED_CA=true
MYSQL_ATTR_SSL_CA=/home/site/wwwroot/storage/certs/aiven-ca.pem

# F1 runs no background worker, so queued mail/notifications run inline.
QUEUE_CONNECTION=sync
# Single instance: file sessions and cache are enough, and are cleared by a
# redeploy (everyone is signed out) -- acceptable for a preview.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
CACHE_STORE=file

FILESYSTEM_DISK=r2
CLOUDFLARE_R2_ACCESS_KEY_ID=REPLACE_WITH_R2_ACCESS_KEY_ID
CLOUDFLARE_R2_SECRET_ACCESS_KEY=REPLACE_WITH_R2_SECRET_ACCESS_KEY
CLOUDFLARE_R2_BUCKET=your-bucket-name
CLOUDFLARE_R2_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
CLOUDFLARE_R2_PUBLIC_URL=https://your-public-bucket-url
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=false

# SMTP: 587 + empty MAIL_SCHEME = STARTTLS; 465 needs MAIL_SCHEME=smtps.
MAIL_MAILER=smtp
MAIL_HOST=smtp.your-provider.example
MAIL_PORT=587
MAIL_SCHEME=
MAIL_USERNAME=REPLACE_WITH_SMTP_USERNAME
MAIL_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
MAIL_FROM_ADDRESS=noreply@your-domain.example
MAIL_FROM_NAME="${APP_NAME}"

# true only for the deployment that must apply new migrations; turn it back
# off once the log stream shows they ran.
RUN_MIGRATIONS_ON_STARTUP=false
