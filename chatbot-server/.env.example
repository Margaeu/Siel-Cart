# Deployed as its own Railway service, separate from the Laravel app on
# Azure. Set these as Railway environment variables for that service --
# they are not read from the Laravel app's .env.

OPENROUTER_API_KEY=REPLACE_WITH_OPENROUTER_KEY
PORT=3000

# Same Aiven MySQL database the Laravel app uses, so recommendations reflect
# the real catalog. DB_USER/DB_NAME are also accepted as aliases for
# DB_USERNAME/DB_DATABASE below, to match Laravel's .env naming.
DB_HOST=your-service-your-project.x.aivencloud.com
DB_PORT=REPLACE_WITH_AIVEN_PORT
DB_DATABASE=defaultdb
DB_USERNAME=avnadmin
DB_PASSWORD=REPLACE_WITH_AIVEN_PASSWORD

# Optional: only needed if the committed cert at chatbot-server/certs/aiven-ca.pem
# ever needs to be overridden. See chatbot-server/certs/README.md.
# MYSQL_ATTR_SSL_CA=certs/aiven-ca.pem
