# Siel Cart -- Nginx site for Azure App Service (Linux, built-in PHP image).
#
# `default` is the canonical file: startup.sh copies it to
# /etc/nginx/sites-available/default on every container start. `nginx.conf`
# is a byte-identical compatibility copy; the deploy workflow fails with
# `cmp` if the two drift, so edit `default` and copy it over.

server {
    listen 8080;
    listen [::]:8080;
    server_name _;

    root /home/site/wwwroot/public;
    index index.php;
    charset utf-8;

    server_tokens off;

    # Uploads are capped at 10 MB per file by Livewire and the validation
    # rules, but Livewire sends a multi-file selection in one request (up to
    # five review photos), so the body limit covers 5 x 10 MB plus multipart
    # overhead. Keep in step with post_max_size in public/.user.ini.
    client_max_body_size 64M;
    client_body_timeout 300s;

    # Every non-file request goes through Laravel's front controller.
    location / {
        try_files $uri $uri/ /index.php?$query_string;
    }

    # Hidden files (.env, .htaccess, .user.ini, .git) are never served.
    # .well-known stays reachable for domain and certificate validation.
    location ~ /\.(?!well-known).* {
        deny all;
    }

    # Vite's build output is content-hashed, so a changed file gets a new
    # name and these can be cached for a year without going stale.
    location ^~ /build/assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    # Self-hosted fonts do not change between deployments.
    location ~* \.(?:woff2?|ttf|otf|eot)$ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, max-age=31536000, immutable" always;
        access_log off;
    }

    location = /favicon.ico {
        try_files $uri =404;
        access_log off;
        log_not_found off;
    }

    location = /robots.txt {
        try_files $uri =404;
        access_log off;
        log_not_found off;
    }

    # PHP-FPM from Azure's PHP image. No cache headers here: dynamic
    # responses keep whatever Laravel sends.
    location ~ \.php$ {
        # Reject requests for PHP files that do not exist instead of handing
        # an arbitrary path to PHP-FPM.
        try_files $uri =404;

        fastcgi_split_path_info ^(.+\.php)(/.+)$;
        fastcgi_pass 127.0.0.1:9000;
        fastcgi_index index.php;
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME $document_root$fastcgi_script_name;
        fastcgi_param PATH_INFO $fastcgi_path_info;

        fastcgi_read_timeout 300s;
        fastcgi_send_timeout 300s;
        fastcgi_buffers 16 16k;
        fastcgi_buffer_size 32k;
    }
}
