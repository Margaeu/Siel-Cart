APP_NAME="SIEL CART"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Local development uses MySQL. For Aiven, copy the host, port, database,
# user and password exactly from the service's "Connection information" --
# Aiven uses a custom port, not 3306.
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=clsu
DB_USERNAME=root
DB_PASSWORD=

# Aiven TLS. Leave MYSQL_ATTR_SSL_CA empty to use storage/certs/aiven-ca.pem
# when it exists; a relative path is read from the project root.
# DB_SSL_VERIFY_SERVER_CERT defaults to on whenever a CA is found.
# DB_SSL_REQUIRE_VERIFIED_CA=true refuses to start without a readable CA
# (always true on Azure; see .env.azure.example).
MYSQL_ATTR_SSL_CA=
DB_SSL_VERIFY_SERVER_CERT=
DB_SSL_REQUIRE_VERIFIED_CA=false

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set to true on any HTTPS host so the session cookie is never sent over HTTP.
SESSION_SECURE_COOKIE=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# SMTP: port 587 with an empty MAIL_SCHEME uses STARTTLS; port 465 needs
# MAIL_SCHEME=smtps. The server's certificate is always verified.
MAIL_MAILER=log
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# Cloudflare R2 (the `r2` disk) holds product, category, banner and review
# media. ENDPOINT is https://<account-id>.r2.cloudflarestorage.com and
# PUBLIC_URL is the bucket's public (r2.dev or custom domain) base URL.
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=
CLOUDFLARE_R2_BUCKET=
CLOUDFLARE_R2_ENDPOINT=
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_R2_USE_PATH_STYLE_ENDPOINT=false

# Azure only: run `migrate --force --isolated` in startup.sh. Keep false
# locally and turn it on in Azure only for a deployment that adds migrations.
RUN_MIGRATIONS_ON_STARTUP=false

VITE_APP_NAME="${APP_NAME}"
